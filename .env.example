# ---- Instagram / Meta ----
# App Secret from your Meta app (Settings > Basic). Used to verify webhook signatures.
INSTAGRAM_APP_SECRET=

# A string you invent. You enter the SAME value in the Meta webhook config and here.
INSTAGRAM_VERIFY_TOKEN=

# Long-lived Instagram User access token (Send API).
INSTAGRAM_ACCESS_TOKEN=

# Your Instagram professional account ID (IG_ID).
INSTAGRAM_ACCOUNT_ID=

# Optional overrides (defaults shown).
GRAPH_API_VERSION=v23.0
GRAPH_BASE_URL=https://graph.instagram.com

# ---- Dynamics 365 Omnichannel (Direct Line custom channel) ----
# Direct Line secret from the custom messaging channel you register in OC admin center.
DIRECT_LINE_SECRET=

# Optional override (default shown).
DIRECT_LINE_BASE_URL=https://directline.botframework.com

# ---- Relay behaviour (optional) ----
PORT=8080
POLL_INTERVAL_MS=2000
CONVERSATION_IDLE_MS=86400000
